# Copiar este archivo como terraform.tfvars y completar valores reales.
# terraform.tfvars esta ignorado por git.

subscription_id = "00000000-0000-0000-0000-000000000000"

project_slug = "posfifo"
environment  = "staging"
location     = "canadacentral"

# Tu suscripcion de estudiante/free puede limitar regiones. Canada Central fue
# la region permitida para PostgreSQL y Container Apps en pruebas previas.
observability_location  = null
static_web_app_location = "centralus"
static_web_app_sku_tier = "Free"
static_web_app_sku_size = "Free"

log_retention_days = 30

extra_tags = {
  owner = "santiago"
}
enable_static_web_app = false

# Media publica cloud (imagenes de productos/logos). Mantener apagado hasta
# necesitar pruebas staging con imagenes para evitar costo duplicado.
enable_media_storage                         = false
media_storage_account_name                   = null
media_storage_container_name                 = "media-public"
grant_current_user_media_blob_contributor    = true

# Backend container platform.
# Azure for Students puede limitar a 1 Container Apps Environment por region.
# En ese caso staging reutiliza el environment dev existente y mantiene su
# propia Container App/API/job, RG, Key Vault, state y DB.
project_name            = "posfifo"
container_apps_location = null
acr_name                = null
acr_sku                 = "Basic"

existing_container_apps_environment_id   = "/subscriptions/e88372f6-b224-4d73-bf17-c61f32559c45/resourceGroups/posfifo-dev-rg/providers/Microsoft.App/managedEnvironments/posfifo-dev-aca-env"
existing_container_apps_environment_name = "posfifo-dev-aca-env"

enable_api_container_app = false
enable_migrate_job       = false
enable_db_per_tenant     = true

container_image_repository = "pos-fifo-backend"
container_image_tag        = "staging"

# Requeridos solo cuando enable_api_container_app o enable_migrate_job sean true.
django_secret_key = null
db_name           = "pos_fifo_staging"
db_user           = null
db_password       = null
db_host           = null
db_port           = "5432"
db_sslmode        = "require"

api_allowed_hosts         = ".azurecontainerapps.io,localhost,127.0.0.1"
api_cors_allowed_origins  = "http://localhost:5173,http://127.0.0.1:5173,https://salmon-rock-01cc45c10.7.azurestaticapps.net"
api_csrf_trusted_origins  = "https://salmon-rock-01cc45c10.7.azurestaticapps.net"
api_min_replicas          = 1
api_max_replicas          = 1
app_version               = "staging"
git_commit_sha            = "unknown"

# D3 secrets foundation.
enable_key_vault                                = true
key_vault_name                                  = null
key_vault_location                              = null
key_vault_purge_protection_enabled              = false
grant_current_user_key_vault_secrets_officer    = true
use_key_vault_secrets                           = false
django_secret_key_secret_name                   = "django-secret-key"
db_password_secret_name                         = "db-password"

# D3 GitHub Actions OIDC identity.
# En staging dejar apagado hasta decidir si el deploy sera manual o via GitHub
# Actions con variables/secrets separados.
enable_github_actions_identity = false
github_actions_identity_name   = null
github_repository_owner        = null
github_repository_name         = null
github_deploy_branch           = "staging"
