# ============================================================================
# Variables de entorno por instalación — POS FIFO (sucursal local)
# ============================================================================
# Copiar a las variables de entorno del sistema/servicio que corre Django
# (el proyecto no carga .env automáticamente; este archivo es la referencia
# de qué se puede configurar en cada instalación sin tocar código).
#
# Todos los valores tienen default razonable para desarrollo: una instalación
# nueva solo define lo que difiere de su hardware/entorno.
#
# La configuración de NEGOCIO (nombre, RNC, logo, ITBIS %, métodos de pago,
# días de anulación, pie de ticket, inventario negativo, módulos) NO va aquí:
# se administra por sucursal en ConfiguracionNegocio desde el panel/admin.

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-unica
DJANGO_DEBUG=false
# Lista separada por comas. Ej: pos.local,192.168.1.10
DJANGO_ALLOWED_HOSTS=*

# --- Base de datos (PostgreSQL) ---
DB_NAME=pos_fifo_db
DB_USER=pos_user
DB_PASSWORD=Prueba123
DB_HOST=localhost
DB_PORT=5432

# --- Sucursal de esta instalación ---
SUCURSAL_CODIGO=SD-001

# --- Impresora térmica de tickets (ESC/POS 80mm) ---
THERMAL_PRINTER_ENABLED=true
# Nombre exacto en "Dispositivos e impresoras" de Windows
THERMAL_PRINTER_NAME=2connect pos
# Solo si la conexión por driver de Windows falla (python -m escpos.cli ls)
#THERMAL_USB_VENDOR_ID=
#THERMAL_USB_PRODUCT_ID=
THERMAL_CHARSET=CP850
THERMAL_CASH_DRAWER=true
# 0 = pin 2, 1 = pin 5
THERMAL_CASH_DRAWER_PIN=0
# 80mm = 48 caracteres
THERMAL_PAPER_WIDTH=48
# Ancho del logo del ticket en píxeles (la imagen se sube en ConfiguracionNegocio)
THERMAL_LOGO_WIDTH=200

# --- Impresora de etiquetas Zebra (EPL2) ---
# Nombre exacto en "Dispositivos e impresoras" de Windows
ZEBRA_PRINTER_NAME=ZDesigner LP 2824

# --- Sincronización con el cloud (vacío/false = modo standalone) ---
SYNC_ENABLED=false
CLOUD_API_URL=
CLOUD_API_TOKEN=
SYNC_INTERVAL=60
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=10
SYNC_HTTP_TIMEOUT=10

# --- Facturación electrónica (e-CF) ---
# Las credenciales del proveedor se referencian por NOMBRE de variable desde
# Emisor.config_proveedor (ej: {"api_key_env": "MSELLER_API_KEY_MI_NEGOCIO"}).
# Definir aquí la variable que ese registro indique:
#MSELLER_API_KEY_MI_NEGOCIO=
