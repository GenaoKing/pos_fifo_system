@echo off
REM ============================================================================
REM POS FIFO System - Variables de Entorno del Cliente v3
REM
REM INSTRUCCIONES:
REM   1. Copiar este archivo como "env_cliente.bat" (sin .template)
REM   2. Editar los valores segun la instalacion del cliente
REM   3. El instalador lo hace automaticamente la primera vez
REM
REM NOTA: Los datos del negocio (nombre, RNC, direccion, telefono) ya NO van
REM       aqui. Se configuran desde el panel de Configuracion del Sistema
REM       (rol SYSADMIN) o con: python manage.py crear_config_inicial
REM ============================================================================

REM --- Encoding (NO TOCAR - previene errores en Windows espanol) ---
set PGCLIENTENCODING=UTF8
set PYTHONUTF8=1

REM --- Base de datos ---
set DB_NAME=royal_plastic_pos
set DB_USER=pos_admin
set DB_PASSWORD=CAMBIAR-CONTRASENA-BD
set DB_HOST=localhost
set DB_PORT=5432

REM --- Red ---
set SERVER_IP=127.0.0.1
set SERVER_PORT=8080
REM Si otras PCs acceden al sistema, agregar sus IPs separadas por coma:
set EXTRA_HOSTS=

REM --- Django ---
set DJANGO_SETTINGS_MODULE=config.settings_production
set DJANGO_DEBUG=false
REM Entrecomillada: evita que un &/(/) en la key parta el comando en cmd.
set "DJANGO_SECRET_KEY=CAMBIAR-POR-KEY-UNICA-POR-INSTALACION"

REM --- Usuario inicial ---
set INITIAL_SYSADMIN_USERNAME=Santiago
set INITIAL_SYSADMIN_PASSWORD=CAMBIAR-PASSWORD-INICIAL-SYSADMIN

REM --- Impresoras (nombre EXACTO de "Dispositivos e impresoras") ---
REM Configurar DESPUES de instalar drivers. Dejar vacio hasta entonces.
REM PRINTER_TERMICA/PRINTER_ZEBRA es la UNICA fuente del nombre; el mapeo de
REM abajo las traduce a lo que la app realmente lee (THERMAL_PRINTER_NAME /
REM ZEBRA_PRINTER_NAME). No editar el mapeo.
set PRINTER_TERMICA=
set PRINTER_ZEBRA=
if defined PRINTER_TERMICA set "THERMAL_PRINTER_NAME=%PRINTER_TERMICA%"
if defined PRINTER_ZEBRA set "ZEBRA_PRINTER_NAME=%PRINTER_ZEBRA%"
set THERMAL_PRINTER_ENABLED=true
set THERMAL_CHARSET=CP850
set THERMAL_CASH_DRAWER=true
set THERMAL_CASH_DRAWER_PIN=2
set THERMAL_PAPER_WIDTH=48
set THERMAL_LOGO_WIDTH=200

REM --- Preset de negocio para configuracion inicial ---
REM Opciones: plasticos, accesorios_auto, retail_general
REM Se usa SOLO en la primera instalacion (crear_config_inicial)
set NEGOCIO_PRESET=plasticos
set NEGOCIO_NOMBRE=Mi Negocio

REM ============================================================================
REM --- Sincronizacion con la nube (cloud) ---
REM ============================================================================
REM Dejar SYNC_ENABLED=false hasta tener el token de la sucursal.
REM Para ACTIVAR el sync:
REM   1. En el cloud (produccion) registrar la Sucursal y generar el token con:
REM        python manage.py vincular_sucursal_token --sucursal <SUCURSAL_CODIGO>
REM   2. Pegar el token en CLOUD_API_TOKEN y poner la URL del cloud de produccion.
REM   3. Poner SYNC_ENABLED=true.
REM   4. Registrar el daemon de sync: deploy\registrar_sync_servicio.bat (admin)
REM
REM IMPORTANTE: SUCURSAL_CODIGO debe coincidir EXACTAMENTE con el codigo de la
REM Sucursal creada en el cloud y con la Sucursal local (crear_sucursal).
set SYNC_ENABLED=false
set SUCURSAL_CODIGO=SD-001
set CLOUD_API_URL=https://CAMBIAR-URL-CLOUD-PRODUCCION
set CLOUD_API_TOKEN=PEGAR-TOKEN-DE-vincular_sucursal_token

REM Parametros del engine (defaults razonables; no suele hacer falta tocarlos)
set SYNC_INTERVAL=60
set SYNC_BATCH_SIZE=50
set SYNC_MAX_RETRIES=10
set SYNC_HTTP_TIMEOUT=10

REM --- Servidor local ---
set SERVER_THREADS=4

REM --- Rutas (no editar) ---
set POS_DIR=%~dp0..
set BACKUP_DIR=%POS_DIR%\backups
