# ============================================================================
# POS FIFO System - Configuracion de la instalacion
#
# INSTRUCCIONES
#   1. Copiar este archivo como "env_cliente.env" (sin .template)
#   2. Editar los valores segun la instalacion del cliente
#   3. El instalador lo hace automaticamente la primera vez
#
# CAMBIAR UN VALOR = editar aqui + reiniciar el servicio.
#   nssm restart POSFifoSystem
#   nssm restart POSFifoSync
# NO hace falta volver a registrar el servicio: la aplicacion lee este archivo
# al arrancar.
#
# FORMATO
#   - Una linea por variable: NOMBRE=valor
#   - Los valores se toman TAL CUAL: no hace falta escapar nada.
#     Los espacios se conservan:  THERMAL_PRINTER_NAME=2connect pos
#     Los simbolos tambien:       DJANGO_SECRET_KEY=abc&def(ghi)
#   - NO usar comillas salvo que formen parte del valor.
#   - NO poner `set ` delante (eso era el formato .bat anterior).
#
# Los datos del negocio (nombre, RNC, direccion, telefono) NO van aqui: se
# configuran desde el panel de Configuracion del Sistema (rol SYSADMIN).
# ============================================================================

# --- Encoding (NO TOCAR: previene errores en Windows en espanol) ---
PGCLIENTENCODING=UTF8
PYTHONUTF8=1

# --- Base de datos ---
DB_NAME=royal_plastic_pos
DB_USER=pos_admin
DB_PASSWORD=CAMBIAR-CONTRASENA-BD
DB_HOST=localhost
DB_PORT=5432

# --- Red ---
SERVER_IP=127.0.0.1
SERVER_PORT=8080
SERVER_THREADS=4
# Si otras PCs acceden al sistema, sus IPs separadas por coma:
EXTRA_HOSTS=

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=false
# Unica por instalacion. Puede contener cualquier simbolo: aqui no se escapa.
DJANGO_SECRET_KEY=CAMBIAR-POR-KEY-UNICA-POR-INSTALACION

# --- Usuario inicial (solo primera instalacion) ---
INITIAL_SYSADMIN_USERNAME=Santiago
INITIAL_SYSADMIN_PASSWORD=CAMBIAR-PASSWORD-INICIAL-SYSADMIN

# --- Impresoras ---
# Nombre EXACTO como aparece en "Dispositivos e impresoras", con sus espacios.
# Configurar DESPUES de instalar los drivers; dejar vacio hasta entonces.
THERMAL_PRINTER_NAME=
ZEBRA_PRINTER_NAME=
THERMAL_PRINTER_ENABLED=true
THERMAL_CHARSET=CP850
THERMAL_CASH_DRAWER=true
# python-escpos solo acepta 2 o 5
THERMAL_CASH_DRAWER_PIN=2
THERMAL_PAPER_WIDTH=48
THERMAL_LOGO_WIDTH=200
THERMAL_USB_VENDOR_ID=
THERMAL_USB_PRODUCT_ID=

# --- Preset de negocio (solo primera instalacion) ---
# Opciones: plasticos, accesorios_auto, retail_general
NEGOCIO_PRESET=plasticos
NEGOCIO_NOMBRE=Mi Negocio

# ============================================================================
# Sincronizacion con la nube
# ============================================================================
# Dejar SYNC_ENABLED=false hasta tener el token de la sucursal.
#
# Para ACTIVAR el sync:
#   1. En el cloud: python manage.py vincular_sucursal_token --sucursal <CODIGO>
#   2. Pegar el token en CLOUD_API_TOKEN y la URL del cloud de produccion.
#   3. Poner SYNC_ENABLED=true.
#   4. Registrar el daemon: deploy\registrar_sync_servicio.bat (como admin)
#
# SUCURSAL_CODIGO debe coincidir EXACTAMENTE con el codigo de la Sucursal en el
# cloud y con la Sucursal local (crear_sucursal).
#
# NOTA: los eventos se encolan aunque SYNC_ENABLED=false; encender el sync mas
# tarde recupera el historico en vez de perderlo. Lo que NO se hace sin sync es
# enviarlos.
SYNC_ENABLED=false
SUCURSAL_CODIGO=SD-001
CLOUD_API_URL=https://CAMBIAR-URL-CLOUD-PRODUCCION
CLOUD_API_TOKEN=PEGAR-TOKEN-DE-vincular_sucursal_token

# Parametros del engine (defaults razonables)
SYNC_INTERVAL=60
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=10
SYNC_HTTP_TIMEOUT=10
