# Variables minimas para correr el backend cloud en Docker.
# Copiar como deploy/env_cloud.local y completar valores reales.
# No guardar secretos reales en git.

DJANGO_SETTINGS_MODULE=config.settings_cloud
CLOUD_ENVIRONMENT=dev
APP_VERSION=local-docker
GIT_COMMIT_SHA=local

DJANGO_SECRET_KEY=CAMBIAR-POR-SECRET-KEY-LARGA-Y-UNICA-PARA-ESTE-AMBIENTE-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local Docker corre por HTTP. En Azure/prod dejar true o no definirlo.
SECURE_SSL_REDIRECT=false

# Para Docker Desktop hablando con PostgreSQL en tu host Windows:
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=pos_fifo_db
DB_USER=pos_user
DB_PASSWORD=CAMBIAR-POR-PASSWORD-BD
DB_SSLMODE=disable

DJANGO_LOG_LEVEL=INFO
